# ── Copy to .env for local dev. In production set these as host secrets. ──

# PostgreSQL (e.g. Supabase: Project Settings → Database → Session pooler)
PG_HOST=localhost
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=

# Qdrant (e.g. Qdrant Cloud cluster URL + API key)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=

# LLMs
GROQ_API_KEY=
# Optional per-task Groq keys (fall back to GROQ_API_KEY)
GROQ_GENERATION_API_KEY=
GROQ_MEMORY_API_KEY=
GROQ_CSV_API_KEY=
GROQ_OCR_API_KEY=
GROQ_CAPTION_API_KEY=
GROQ_EVAL_API_KEY=

# Embedding model: HF hub id or local directory (the Docker image sets a baked-in path)
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker — set to use the hosted Jina API instead of the local ~560 MB model
JINA_API_KEY=

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin(s) allowed by CORS and used in OAuth/share links
FRONTEND_URL=http://localhost:5173
# Extra comma-separated origins, and an optional regex (e.g. Vercel previews)
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Optional
REDIS_URL=
OLLAMA_HOST=http://localhost:11434
LANGCHAIN_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
